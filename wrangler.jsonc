{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wardogs-discord-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WATCHER", "class_name": "Watcher" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Watcher"] }],
  "observability": { "enabled": true },
  // Non-secret settings. RCON_URL, RCON_PASSWORD and DISCORD_WEBHOOK_URL are secrets: see the README. So are
  // DISCORD_STATUS_WEBHOOK_URL, the optional channel for the live server status, DISCORD_ROUNDUP_WEBHOOK_URL, the
  // optional channel for the weekly and monthly roundups, KILL_FEED_TOKEN, which turns on the weapon stats,
  // DISCORD_MODLOG_WEBHOOK_URL, the optional staff channel for the moderation log, DISCORD_CLIENT_SECRET, for the staff
  // page's Discord sign-in, DISCORD_BOT_TOKEN, optional, so the staff page can name staff it has not seen, and
  // STEAM_API_KEY, optional, which turns on the checks for risky Steam accounts.
  "vars": {
    // The Seeders role, which members pick in the role menu. Pinged on every alert: seeding, live and low pop (seeding
    // and low pop not at night: see QUIET_START_HOUR).
    "DISCORD_ROLE_ID": "1554801355015594025",
    // Optional: an invite link that never expires, for the member counts in /api/stats and the welcome message.
    "DISCORD_INVITE": "https://discord.gg/qsJFYGhSJ4",
    // Optional: the community website. Discord posts link to it, and in-game messages point players at it.
    "SITE_URL": "https://gaminginit.com",
    // Optional: the server's ID for Join by ID in the game's server browser. The alerts, /serverstatus and the live
    // status show it, with how to join.
    "SERVER_ID": "2615de90-da95-4950-913a-246b1db49237",
    // In-game messages during a match (10 minutes in, halfway, a team near winning): "on" or "off".
    "MATCH_MESSAGES": "on",
    // The score a team needs to win: halfway is half of it, "near winning" is 90% of it.
    "SCORE_TO_WIN": "100",
    // While the server seeds, an in-game message about seeding and what it earns, every this many minutes and 30 seconds
    // after someone joins (below 20 players). "0" turns both off.
    "SEEDING_MESSAGE_MINUTES": "5",
    // A private message to each player this many minutes after they join, with the basic rules, the Discord
    // (DISCORD_INVITE) and the website (SITE_URL). Not again for 6 hours, so a map change doesn't send it to everyone.
    // "0" turns it off.
    "WELCOME_MESSAGE_MINUTES": "2",
    "SEEDING_THRESHOLD": "1",
    "LIVE_THRESHOLD": "20",
    "LOW_POP_THRESHOLD": "20",
    // The website's busy times: the hours when the server usually has at least this many players.
    "BUSY_THRESHOLD": "97",
    "ALERT_COOLDOWN_MINUTES": "10",
    // A drop in players only counts once it lasts this long, so a crash or restart that fills again quickly pings nobody.
    "DROP_GRACE_MINUTES": "5",
    // The night (hours 0 to 23 in QUIET_TIME_ZONE), when the seeding and low-pop alerts go out without pinging the
    // Seeders role. Europe/London follows the clocks changing, so 21 to 6 is 9pm to 6am in summer and winter. The same
    // hour for both turns it off.
    "QUIET_START_HOUR": "21",
    "QUIET_END_HOUR": "6",
    "QUIET_TIME_ZONE": "Europe/London",
    // Required for the staff commands: your Discord server's ID (right-click the server icon → Copy Server ID).
    "DISCORD_GUILD_ID": "1552990539455144086",
    // Optional: role IDs (comma-separated) that may use the admin commands as well as Administrators. Staff.
    "DISCORD_ADMIN_ROLE_IDS": "1552990722976649296",
    // For the staff page's Discord sign-in: the application's ID (Developer Portal → General Information). Not a secret.
    // Keep it here: a value set in the Cloudflare dashboard is replaced by this file at every deploy.
    "DISCORD_APPLICATION_ID": "1554816090452795484",
    // Posts to the moderation log when a player passes a griefing flag (3 team kills, 2 vehicle suicides): "on" or "off".
    "GRIEF_ALERTS": "on",
    // Posts to the moderation log when a player with one of the riskiest Steam accounts (7 points or more) is in game
    // (needs STEAM_API_KEY): "on" or "off".
    "STEAM_ALERTS": "on",
    // Automatic VIP: seed on this many days in a week to get a reserved slot for a week. "0" turns it off.
    "VIP_SEED_DAYS": "3",
    // A seed counts when a player is on for more than this many minutes while the server seeds, and it goes live.
    "VIP_SEED_MINUTES": "10",
    // The hour (UTC, 0 to 23) each day's map rotation starts (see /rotations). 5 is 6am in the UK in summer, 5am in winter,
    // so a late night keeps the evening's rotation.
    "ROTATION_HOUR": "5",
    // Weekly and monthly roundups of the best players and team, posted to Discord: "on" or "off".
    "ROUNDUPS": "on",
    // The hour (UTC, 0 to 23) on Mondays, and on the 1st of the month, when the roundups go out. 17 is 6pm in the UK in
    // summer, 5pm in winter.
    "ROUNDUP_HOUR": "17"
  }
}
