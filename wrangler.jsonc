{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wardogs-discord-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WATCHER", "class_name": "Watcher" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Watcher"] }],
  "observability": { "enabled": true },
  // Non-secret settings. RCON_URL, RCON_PASSWORD and DISCORD_WEBHOOK_URL are secrets: see the README. So are
  // DISCORD_STATUS_WEBHOOK_URL, the optional channel for the live server status, DISCORD_ROUNDUP_WEBHOOK_URL, the
  // optional channel for the weekly and monthly roundups, KILL_FEED_TOKEN, which turns on the weapon stats,
  // DISCORD_MODLOG_WEBHOOK_URL, the optional staff channel for the moderation log, DISCORD_CLIENT_SECRET, for the staff
  // page's Discord sign-in, DISCORD_BOT_TOKEN, optional, so the staff page can name staff it has not seen, and
  // STEAM_API_KEY, optional, which turns on the checks for risky Steam accounts.
  "vars": {
    // The Seeders role, which members pick in the role menu. Pinged on every alert: seeding, live and low pop (seeding
    // and low pop not at night: see QUIET_START_HOUR).
    "DISCORD_ROLE_ID": "1554801355015594025",
    // Optional: an invite link that never expires, for the member counts in /api/stats and the welcome message.
    "DISCORD_INVITE": "https://discord.gg/qsJFYGhSJ4",
    // Optional: the community website. Discord posts link to it, and in-game messages point players at it.
    "SITE_URL": "https://gaminginit.com",
    // Optional: a path on the website that counts the click and sends people to DISCORD_INVITE. The welcome message in game
    // gives it ("gaminginit.com/discord") instead of the invite code, which is too long to type. The path is the website's
    // (`public/_redirects`), so the website must be deployed too: if the bot goes out first, the link does not work until it does.
    // Left out, the welcome gives the invite code.
    "DISCORD_SHORT_LINK": "/discord",
    // Player accounts (the website's "Sign in with Discord"): the "Gamer" role a player gets for linking their Steam account, and
    // the "VIP" role they have while they have seeder VIP. The bot's own role must be above them, with Manage Roles. Either may be
    // left out. They need DISCORD_BOT_TOKEN.
    "DISCORD_LINKED_ROLE_ID": "1561072498135539873",
    "DISCORD_VIP_ROLE_ID": "1561072072967585913",
    // The roles the player of the month and the weekly challenge winner get on their linked account, after the roundups. The
    // bot's own role must be above them, with Manage Roles. Either may be left out: the posts still go out.
    "DISCORD_PLAYER_OF_MONTH_ROLE_ID": "1562112822601584650",
    "DISCORD_CHALLENGE_ROLE_ID": "1562112936728731658",
    // A Discord message to linked players who haven't played for 14 days, when the server seeds: "on" or "off".
    "ASK_BACK": "off",
    // Optional: the server's ID for Join by ID in the game's server browser. The alerts, /serverstatus and the live
    // status show it, with how to join.
    "SERVER_ID": "2615de90-da95-4950-913a-246b1db49237",
    // In-game messages during a match (10 minutes in, halfway, a team near winning): "on" or "off".
    "MATCH_MESSAGES": "on",
    // The score a team needs to win: halfway is half of it, "near winning" is 90% of it. Without the kill feed, the bot
    // also takes a team on it as having won.
    "SCORE_TO_WIN": "100",
    // While the server seeds, an in-game message about seeding and what it earns, every this many minutes and 30 seconds
    // after someone joins (below 20 players). "0" turns both off.
    "SEEDING_MESSAGE_MINUTES": "5",
    // A private message to each player this many minutes after they join, with the basic rules, the Discord
    // (DISCORD_INVITE) and the website (SITE_URL). Not again for 6 hours, so a map change doesn't send it to everyone.
    // "0" turns it off.
    "WELCOME_MESSAGE_MINUTES": "2",
    // The moment a team wins a match, a private message to this many of the top players on its scoreboard, with where
    // they finished and the website (SITE_URL) for their stats. "0" sends none.
    "TOP_PLAYER_MESSAGES": "5",
    // With them, one to each of the match's award winners from the kill feed (best demolitions, most headshots and the
    // rest): "on" or "off".
    "AWARD_MESSAGES": "on",
    "SEEDING_THRESHOLD": "1",
    "LIVE_THRESHOLD": "20",
    "LOW_POP_THRESHOLD": "20",
    // The website's busy times: the hours when the server usually has at least this many players.
    "BUSY_THRESHOLD": "97",
    "ALERT_COOLDOWN_MINUTES": "10",
    // A drop in players only counts once it lasts this long, so a crash or restart that fills again quickly pings nobody.
    "DROP_GRACE_MINUTES": "5",
    "SEEDING_ALERT_MINUTES": "5",
    // The night (hours 0 to 23 in QUIET_TIME_ZONE), when the seeding and low-pop alerts go out without pinging the
    // Seeders role. Europe/London follows the clocks changing, so 21 to 6 is 9pm to 6am in summer and winter. The same
    // hour for both turns it off.
    "QUIET_START_HOUR": "21",
    "QUIET_END_HOUR": "6",
    "QUIET_TIME_ZONE": "Europe/London",
    // Required for the staff commands: your Discord server's ID (right-click the server icon → Copy Server ID).
    "DISCORD_GUILD_ID": "1552990539455144086",
    // Optional: role IDs (comma-separated) that may use the admin commands as well as Administrators. Staff.
    "DISCORD_ADMIN_ROLE_IDS": "1552990722976649296",
    // For the staff page's Discord sign-in: the application's ID (Developer Portal → General Information). Not a secret.
    // Keep it here: a value set in the Cloudflare dashboard is replaced by this file at every deploy.
    "DISCORD_APPLICATION_ID": "1554816090452795484",
    // Posts to the moderation log when a player passes a griefing flag (4 team kills, 4 vehicle suicides): "on" or "off".
    "GRIEF_ALERTS": "on",
    // Posts to the moderation log when a player with one of the riskiest Steam accounts (7 points or more) is in game
    // (needs STEAM_API_KEY): "on" or "off".
    "STEAM_ALERTS": "on",
    "HEADSHOT_ALERTS": "on",
    "AUTO_FLAGS": "on",
    "OUTAGE_ALERTS": "on",
    // Posts to the moderation log when the server is live and the kill feed has sent nothing for 10 minutes: "on" or "off".
    "FEED_ALERTS": "on",
    // Automatic VIP: seed on this many days in a week to get a whitelist slot for a week. "0" turns it off. Not used while COINS is "on".
    "VIP_SEED_DAYS": "3",
    // Which VIP rule: "week" (VIP_SEED_DAYS above) or "day" (seed on one day to get a whitelist slot for 3 days).
    "VIP_MODE": "week",
    // A seed counts when a player is on for more than this many minutes while the server seeds, and it goes live.
    "VIP_SEED_MINUTES": "10",
    // INITcoins (README, "INITcoins"): "on" replaces automatic seeder VIP above (it stops giving VIP; the VIP already given runs
    // out on its own date) with coins that players earn by seeding, playing and missions, and spend on whitelist days and
    // cosmetics. The first time it is on, seeders get the coins for their seeds in the last 14 days. "off" brings automatic VIP
    // back. The rest are the rates and prices: change them here and deploy. They are balanced against each other (a week of
    // whitelist is about 4 seeds, or 3 seeds and a few evenings of play; playing alone takes well over a week), so change them
    // together.
    "COINS": "on",
    // Paid once a day for a successful seed (the VIP_SEED_MINUTES rule), then 1 more for each COIN_SEED_MINUTES_PER minutes past
    // that, up to COIN_SEED_MINUTES_CAP a day.
    "COIN_SEED": "150",
    "COIN_SEED_MINUTES_PER": "2",
    "COIN_SEED_MINUTES_CAP": "30",
    // 1 for each this many minutes with the server live; a match played, and a match won (the first COIN_MATCHES_PAID matches of
    // the day); and the most all of that and seeding minutes pay in a day. Missions are on top of it.
    "COIN_PLAY_MINUTES": "10",
    "COIN_MATCH": "6",
    "COIN_WIN": "6",
    "COIN_MATCHES_PAID": "6",
    "COIN_DAILY_CAP": "100",
    // A match counts as played for coins with this many kills and deaths together, so sitting in a match earns nothing.
    "COIN_PLAYED_LEAST": "3",
    // The shop: whitelist for a day, for a week, the most days of whitelist anyone can hold at once, and swapping a daily mission.
    "COIN_VIP_DAY_PRICE": "100",
    "COIN_VIP_WEEK_PRICE": "600",
    "COIN_VIP_AHEAD_DAYS": "14",
    "COIN_REROLL_PRICE": "40",
    // Discord roles for sale, as JSON, such as [{"id":"123456789012345678","name":"Night Owl","price":1500}]. The bot's own role must
    // be above them. Needs DISCORD_BOT_TOKEN. Empty for none.
    "COIN_ROLES": "",
    // The hour (UTC, 0 to 23) each day's map rotation starts (see /rotations). 5 is 6am in the UK in summer, 5am in winter,
    // so a late night keeps the evening's rotation.
    "ROTATION_HOUR": "5",
    // Weekly and monthly roundups of the best players and team, posted to Discord: "on" or "off".
    "ROUNDUPS": "on",
    // The hour (UTC, 0 to 23) on Mondays, and on the 1st of the month, when the roundups go out. 17 is 6pm in the UK in
    // summer, 5pm in winter.
    "ROUNDUP_HOUR": "17",
    // The next-map vote in Discord: when a match goes live, a message with a button per map in one channel, open until a team has
    // MAP_VOTE_CLOSE_PERCENT of SCORE_TO_WIN (or for MAP_VOTE_MINUTES at most, a backstop). The winner is put in the rotation as the next map, infantry only,
    // as the vote closes, and announced in game. It does nothing until DISCORD_BOT_TOKEN (a secret) is also set: see the README, "Next-map vote". "on" or "off".
    "MAP_VOTE": "on",
    "MAP_VOTE_OPTIONS": "4",
    "MAP_VOTE_MINUTES": "60",
    // 75 of 100: a rotation edit doesn't end the match, so the vote closes early enough for the winner to be in and announced well before the end.
    "MAP_VOTE_CLOSE_PERCENT": "75",
    // How the winner is put on the server: "rotation" writes it into the rotation as the next map (and back out once it has
    // played), "queue" stages it with POST /v1/match/map once the match is over. "rotation" only, for now: on 17 October
    // staging with POST /v1/match/map mid-match (a team on 95) was followed 1.3 seconds later by the match ending at 96 of 100.
    // See the README, "Next-map vote".
    "MAP_VOTE_STAGING": "rotation",
    // Only players on the server right now can vote: their Discord account needs a linked Steam account (linked on the website) that is
    // in the game. "on" or "off".
    "MAP_VOTE_IN_GAME": "on",
    // The channel the vote is posted in (the bot needs View Channel, Send Messages and Embed Links there).
    "DISCORD_VOTE_CHANNEL_ID": "1561043064800280596",
    // Support tickets (the README, "Support tickets"). Needs DISCORD_BOT_TOKEN. Tickets stay off until the category is set: the
    // category channel's ID (right-click it → Copy Channel ID). The bot needs Manage Channels, View Channel and Send Messages there.
    // The staff roles that see every ticket are DISCORD_ADMIN_ROLE_IDS.
    "DISCORD_TICKET_CATEGORY_ID": "1555263574681714811",
    // Optional: a staff channel that gets a transcript of each ticket when it is closed. Without it closed tickets are just deleted.
    "DISCORD_TICKET_LOG_CHANNEL_ID": "1553006578456596580"
  }
}
