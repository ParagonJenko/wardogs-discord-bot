# Required: RCON listener address from your host's panel, e.g. http://203.0.113.10:7776
RCON_URL=
# Required: RCON password. It gives full admin access to the server, so keep this file private.
RCON_PASSWORD=

# Required: Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Optional: role to @mention on every alert (Server Settings -> Roles -> right-click -> Copy Role ID)
DISCORD_ROLE_ID=

# Optional: the server's ID for Join by ID in the game's server browser, shown on the alerts with how to join
SERVER_ID=

# Optional: thresholds (defaults shown)
SEEDING_THRESHOLD=1
LIVE_THRESHOLD=20
LOW_POP_THRESHOLD=20

# Optional: how often to check the server, and the minimum gap between two alerts of the same kind
POLL_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=10
DROP_GRACE_MINUTES=5
# Optional: the seeding alert waits until an empty server has kept its first players this long (0: straight away)
SEEDING_ALERT_MINUTES=5

# Optional: the night, when the seeding and low-pop alerts go out without pinging the role, in the time zone's own
# hours (9pm to 6am UK time, summer and winter). The same hour for both turns it off.
QUIET_START_HOUR=21
QUIET_END_HOUR=6
QUIET_TIME_ZONE=Europe/London

# Optional: while the server seeds, an in-game message about seeding every this many minutes, and 30 seconds after
# someone joins. 0 turns both off.
SEEDING_MESSAGE_MINUTES=5

# Optional: a private message to each player this many minutes after they join, with the basic rules, and the Discord
# and website when set. Not again for 6 hours. 0 turns it off.
WELCOME_MESSAGE_MINUTES=2
DISCORD_INVITE=
SITE_URL=

# Optional: the moment a team wins a match, a private message to this many of the top players on its scoreboard, with
# where they finished and the website (needs SITE_URL). 0 sends none. The award winners need the kill feed (Cloudflare),
# so AWARD_MESSAGES does nothing here.
TOP_PLAYER_MESSAGES=5

# Optional (Cloudflare only): the next-map vote in Discord. When a match goes live, a message with a button per map in
# DISCORD_VOTE_CHANNEL_ID, open for MAP_VOTE_MINUTES (or until a team has 75% of SCORE_TO_WIN); the winner is staged as
# the next map, infantry only. Needs DISCORD_BOT_TOKEN (a webhook can't carry buttons). "on" or "off".
# MAP_VOTE=off
# MAP_VOTE_OPTIONS=4
# MAP_VOTE_MINUTES=15
# DISCORD_VOTE_CHANNEL_ID=

# Only for `npm run register` (registers /serverstatus with Discord). Not used by the bot itself.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
