# Required: RCON listener address from your host's panel, e.g. http://203.0.113.10:7776
RCON_URL=
# Required: RCON password. It gives full admin access to the server, so keep this file private.
RCON_PASSWORD=

# Required: Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Optional: role to @mention on every alert (Server Settings -> Roles -> right-click -> Copy Role ID)
DISCORD_ROLE_ID=

# Optional: thresholds (defaults shown)
SEEDING_THRESHOLD=1
LIVE_THRESHOLD=20
LOW_POP_THRESHOLD=20

# Optional: how often to check the server, and the minimum gap between two alerts of the same kind
POLL_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=10
DROP_GRACE_MINUTES=5

# Optional: while the server seeds, an in-game message about seeding every this many minutes, and 30 seconds after
# someone joins. 0 turns both off.
SEEDING_MESSAGE_MINUTES=5

# Only for `npm run register` (registers /serverstatus with Discord). Not used by the bot itself.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
