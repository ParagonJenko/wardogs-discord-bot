# Required: the number at the end of your server's BattleMetrics URL,
# e.g. https://www.battlemetrics.com/servers/wardogs/12345678 -> 12345678
BATTLEMETRICS_SERVER_ID=

# Required: Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Optional: role to @mention on every alert (Server Settings -> Roles -> right-click -> Copy Role ID)
DISCORD_ROLE_ID=

# Optional: thresholds (defaults shown)
SEEDING_THRESHOLD=1
LIVE_THRESHOLD=20
LOW_POP_THRESHOLD=20

# Optional: how often to check BattleMetrics, and the minimum gap between two alerts of the same kind
POLL_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=10
